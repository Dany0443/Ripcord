# HTTP port (defaults to 5224)
PORT=5224

# Simultaneous download tasks processed at once (defaults to 2)
DOWNLOAD_CONCURRENCY=4

# Simultaneous YouTube playlist metadata processes (defaults to 2)
METADATA_CONCURRENCY=4

# Playlist audio encoding workers (defaults to 1-2 based on CPU count)
ENCODE_CONCURRENCY=2

# yt-dlp fragment downloads per track (defaults to 4)
YTDLP_CONCURRENT_FRAGMENTS=4

# Absolute directory for media temporary files (defaults to the OS temp directory)
# WORK_DIR=/dev/shm/ripcord

# Use aria2c for yt-dlp downloads when installed (defaults to false)
YTDLP_USE_ARIA2C=false

# Path to cookies.txt if hosting on a datacenter IP that YouTube challenges
# YTDLP_COOKIES_PATH=cookies.txt

# Rate limiting window in milliseconds (15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000

# Max API requests per IP within the rate limit window
RATE_LIMIT_MAX=80

# Max requests per IP within the rate limit window for each API
FETCH_INFO_RATE_LIMIT_MAX=30
DOWNLOAD_RATE_LIMIT_MAX=8
COVER_RATE_LIMIT_MAX=120

# Maximum pending download requests and concurrent expensive work
MAX_QUEUED_DOWNLOADS=8

# Resource ceilings
MAX_PLAYLIST_TRACKS=30
MAX_PLAYLIST_OUTPUT_BYTES=2097152
MAX_COVER_BYTES=5242880
MAX_DOWNLOAD_BYTES=104857600
MAX_AUDIO_OUTPUT_BYTES=157286400
MAX_ZIP_TRACK_BYTES=41943040

# Number of trusted reverse-proxy hops; leave unset unless deployed behind a known proxy
# TRUST_PROXY_HOPS=1
